{
    if ( clientnum < 0 )
    {
        return undefined;
    }
    
    for ( i = 0; i < level.players.size ; i++ )
    {
        if ( level.players[ i ] getentitynumber() == clientnum )
        {
            return level.players[ i ];
        }
    }
    
    return undefined;
}

